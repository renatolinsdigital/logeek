# EditorConfig (https://editorconfig.org): line endings, indentation and
# charset stay the same in every editor and on every OS.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
# Trailing whitespace is a line break in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
